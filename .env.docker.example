# StructForge Docker Deployment
# Copy this file to .env and fill in your credentials before running docker compose.

# ── LLM ──────────────────────────────────────────────
# Doubao Seed Lite drives structure extraction and script generation.
STRUCTFORGE_DOUBAO_LLM_ENDPOINT=
STRUCTFORGE_DOUBAO_LLM_API_KEY=
STRUCTFORGE_DOUBAO_LLM_MODEL=doubao-seed-2-0-lite

# ── Vision ────────────────────────────────────────────
# Optional override for a dedicated visual understanding endpoint.
# If left empty, the LLM endpoint above is reused for vision.
STRUCTFORGE_DOUBAO_VISION_ENDPOINT=
STRUCTFORGE_DOUBAO_VISION_API_KEY=

# ── AIGC ──────────────────────────────────────────────
# Jimeng image generation for AIGC gap filling.
# If left empty, AIGC strategy falls back to styled placeholder cards.
STRUCTFORGE_JIMENG_IMAGE_ENDPOINT=
STRUCTFORGE_JIMENG_IMAGE_API_KEY=

# ── ASR ───────────────────────────────────────────────
# Volcano speech recognition. WhisperX is used as fallback if available.
STRUCTFORGE_VOLCANO_ASR_ENDPOINT=
STRUCTFORGE_VOLCANO_ASR_API_KEY=

# ── Seed Demo ─────────────────────────────────────────
# Set to "true" (default) to auto-create a demo project on first startup.
STRUCTFORGE_SEED_DEMO=true
