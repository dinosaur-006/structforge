# Local development can run tasks inline without Redis.
STRUCTFORGE_CELERY_TASK_ALWAYS_EAGER=true
STRUCTFORGE_CELERY_BROKER_URL=redis://localhost:6379/0
STRUCTFORGE_CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Media tools and optional font override.
STRUCTFORGE_FFMPEG_PATH=ffmpeg
STRUCTFORGE_FFPROBE_PATH=ffprobe
# STRUCTFORGE_PACKAGING_FONT_PATH=C:/Windows/Fonts/msyh.ttc

# External AI services. Fill values locally only; never commit credentials.
# The Lite multimodal LLM drives both structure generation and visual understanding by default.
STRUCTFORGE_DOUBAO_LLM_ENDPOINT=
STRUCTFORGE_DOUBAO_LLM_API_KEY=
STRUCTFORGE_DOUBAO_LLM_MODEL=doubao-seed-2-0-lite
# Optional override for a separate visual-understanding endpoint/key.
STRUCTFORGE_DOUBAO_VISION_ENDPOINT=
STRUCTFORGE_DOUBAO_VISION_API_KEY=
STRUCTFORGE_VOLCANO_ASR_ENDPOINT=
STRUCTFORGE_VOLCANO_ASR_API_KEY=
STRUCTFORGE_JIMENG_IMAGE_ENDPOINT=
STRUCTFORGE_JIMENG_IMAGE_API_KEY=

# Mock mode: set to true to generate synthetic test clips (colored gradient + text)
# instead of calling real AI APIs. Useful for demos without API quota.
# MOCK_AI_GEN=true
